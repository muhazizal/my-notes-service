# App
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000

# Database (Postgres)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=my_notes_db
DB_HOST=localhost
DB_DIALECT=postgres

# JWT Secrets (use long random strings)
JWT_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_long_random_string

# Redis
REDIS_SOCKET_HOST=127.0.0.1
REDIS_SOCKET_PORT=6379
REDIS_PASSWORD=

# Email (Gmail)
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Frontend URLs used in emails
VERIFY_URL=http://localhost:3001/verify
RESET_URL=http://localhost:3001/reset-password